# CivicConnect Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# Server
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/civicconnect?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# File Upload Directory
UPLOAD_DIR=./uploads

# Default Admin Account (only used for initial seeding)
ADMIN_EMAIL=admin@civicconnect.com
ADMIN_PASSWORD=Admin@123
